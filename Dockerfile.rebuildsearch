# Build the search-index rebuild binary (Go-side Greek normalization;
# the index cannot be rebuilt from pure SQL).
# This image is NOT a service — run it once against the data volume, like
# the migrate image. Mirrors Dockerfile.migrate's runtime stage: pinned
# non-root user (uid/gid 1000) + /app/data so the SQLite WAL/SHM files the
# rebuild writes stay owned by the app user (a root-written WAL would break
# the app) and a fresh volume mount has writable ownership:
#   docker run --rm -v sick-fansubs_sick-data:/app/data \
#     -e DATA_DIR=/app/data sick-fansubs-rebuildsearch:latest
FROM golang:1.27.1-alpine3.24 AS build

WORKDIR /app
COPY go.mod go.sum ./
# Cache mounts (BuildKit): the Go module/build caches persist across
# local builds (these images are built only by the Makefile targets); a
# miss just rebuilds.
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .

# Package build (not the single-file form): a future file split in
# cmd/rebuildsearch cannot break this image.
# Both cache mounts ride the compile step — the download layer's
# /go/pkg/mod is not in the image.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o rebuildsearch ./cmd/rebuildsearch

FROM alpine:3.24
RUN apk add --no-cache ca-certificates && \
    addgroup -S -g 1000 app && adduser -S -u 1000 -G app app && \
    mkdir -p /app/data && chown app:app /app/data && chmod 700 /app/data
COPY --from=build /app/rebuildsearch /rebuildsearch
USER app
ENTRYPOINT ["/rebuildsearch"]
