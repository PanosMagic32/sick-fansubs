# Build the backup command binary.
# This image is NOT a service — use it with "docker compose --profile backup
# run --rm backup". Mirrors Dockerfile.migrate: pinned non-root user (uid/gid
# 1000, compose user: "1000:1000") so the daily unit lands with ownership the
# app and the host-side scripts can read, and /app/data + /app/backups exist
# for volume/bind mounts.
FROM golang:1.27.1-alpine3.24 AS build

WORKDIR /app
COPY go.mod go.sum ./
# Cache mounts (BuildKit): the Go module/build caches persist across runs
# via the workflow's gha cache backend; a miss just rebuilds.
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .

# Build the whole cmd/backup package, not a single file: the command's logic
# is split across main.go + backup.go (the testable-seam convention).
# Both cache mounts ride the compile step — the download layer's
# /go/pkg/mod is not in the image.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o backup ./cmd/backup

FROM alpine:3.24
RUN apk add --no-cache ca-certificates && \
    addgroup -S -g 1000 app && adduser -S -u 1000 -G app app && \
    mkdir -p /app/data /app/backups && chown app:app /app/data /app/backups && chmod 700 /app/data
COPY --from=build /app/backup /backup
USER app
ENTRYPOINT ["/backup"]
