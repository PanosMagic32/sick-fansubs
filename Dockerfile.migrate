# Build the migration binary.
# This image is NOT a service — use it with "docker compose run".
FROM golang:1.27.1-alpine3.24 AS build

WORKDIR /app
COPY go.mod go.sum ./
# Cache mounts (BuildKit): the Go module/build caches persist across runs
# via the workflow's gha cache backend; a miss just rebuilds.
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .

# Both cache mounts ride the compile step — the download layer's
# /go/pkg/mod is not in the image.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o migrate ./cmd/migrate

FROM alpine:3.24
# Mirror the prod image's non-root user (pinned uid/gid 1000, compose
# user: "1000:1000") and /app/data so the migrate profile can seed a
# fresh named volume with writable ownership (adversarial-review fix).
RUN apk add --no-cache ca-certificates && \
    addgroup -S -g 1000 app && adduser -S -u 1000 -G app app && \
    mkdir -p /app/data && chown app:app /app/data && chmod 700 /app/data
COPY --from=build /app/migrate /migrate
USER app
ENTRYPOINT ["/migrate"]
