# Build the restore command binary (the fail-closed staged restore).
# NOT a compose service — a one-off "docker run" on the STOPPED volume, like
# the importavatars leg (docs/ops/restore.md). Mirrors
# Dockerfile.backup: pinned non-root user (uid/gid 1000) so the staged files
# land with the volume's ownership.
FROM golang:1.27.1-alpine3.24 AS build

WORKDIR /app
COPY go.mod go.sum ./
# Cache mounts (BuildKit): the Go module/build caches persist across runs
# via the workflow's gha cache backend; a miss just rebuilds.
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .

# Package build (not the single-file form): a future file split in
# cmd/restore cannot break this image.
# Both cache mounts ride the compile step — the download layer's
# /go/pkg/mod is not in the image.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -o restore ./cmd/restore

FROM alpine:3.24
RUN apk add --no-cache ca-certificates && \
    addgroup -S -g 1000 app && adduser -S -u 1000 -G app app && \
    mkdir -p /app/data && chown app:app /app/data && chmod 700 /app/data
COPY --from=build /app/restore /restore
USER app
ENTRYPOINT ["/restore"]
