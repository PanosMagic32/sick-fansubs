# Sick-Fansubs — production edge
#
# Caddy is the TLS edge for sickfansubs.com behind Cloudflare and owns
# host port 443 (compose maps it). The legacy stack is gone; port 80
# stays unpublished — ACME uses the DNS challenge, so no HTTP or
# TLS-ALPN challenge needs to reach the origin.
#
# Cache headers are deliberately NOT set here — the Go application
# owns them: hashed assets get immutable caching,
# HTML gets security headers, API responses get no-store.

{
	log {
		output stdout
		format filter {
			wrap json
			fields {
				# Credential-bearing request fields must not reach
				# VPS container logs. The reset and verify links
				# carry `?token=`; the page strips the query after
				# its first read, so the first asset fetches still
				# send the same URL as `Referer`. `fields` is the
				# filter encoder's field-manipulation subdirective
				# (`wrap` selects the wrapped encoder).
				request>uri query {
					delete token
				}
				request>headers>Referer delete
			}
		}
	}

	# trusted_proxies is a SERVER option (inside the global "servers"
	# block), not a site-block directive — the site-block form fails to
	# adapt, and the "cloudflare" preset is plugin-only, absent from the
	# standard distribution (Caddy's reference docs).
	# Only "static" ships standard, so the Cloudflare ranges are listed
	# explicitly — the same set the VPS firewall admits at the origin edge.
	# trusted_proxies_strict parses X-Forwarded-For right-to-left
	# (Cloudflare appends), defeating left-most client spoofing.
	servers {
		trusted_proxies static \
			103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
			104.16.0.0/13 104.24.0.0/14 108.162.192.0/18 \
			131.0.72.0/22 141.101.64.0/18 162.158.0.0/15 \
			172.64.0.0/13 173.245.48.0/20 188.114.96.0/20 \
			190.93.240.0/20 197.234.240.0/22 198.41.128.0/17 \
			2400:cb00::/32 2606:4700::/32 2803:f800::/32 \
			2405:b500::/32 2405:8100::/32 2a06:98c0::/29 \
			2c0f:f248::/32
		trusted_proxies_strict
	}
}

sickfansubs.com {
	tls {
		# DNS challenge through the scoped Cloudflare token (from the
		# VPS-side .env, never committed).
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	# HSTS keeps every future request on HTTPS. No preload, and no
	# includeSubDomains until every subdomain serves HTTPS.
	header Strict-Transport-Security "max-age=31536000"

	# Access log (directive, distinct from the global logger options):
	# structured JSON request lines to stdout — also the probe that shows
	# whether Cloudflare requests ever reach this container. The query and
	# Referer filters keep the reset token out of the logs.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
				}
				request>headers>Referer delete
			}
		}
	}

	reverse_proxy app:8080
}

# The apex is canonical — every www request is sent to the same path
# on sickfansubs.com. The DNS challenge matches the apex: the
# Cloudflare proxy terminates TLS, so HTTP and TLS-ALPN validation
# cannot reach the origin.
www.sickfansubs.com {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	# route keeps the written order: the redirect response carries HSTS.
	route {
		header Strict-Transport-Security "max-age=31536000"
		redir https://sickfansubs.com{uri} permanent
	}
}
